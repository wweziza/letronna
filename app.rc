      VALUE "ProductName", "Letronna"
      VALUE "ProductVersion", "0.1.0-alpha.1"
      VALUE "LegalCopyright", "Copyright (c) 2026 Gadlus Engineering"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
